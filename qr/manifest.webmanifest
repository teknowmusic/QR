{
  "name": "TEK_KNOWLEDGE — Scan",
  "short_name": "TEK_QR",
  "description": "Show this code so people can reach @teknowmusic — site, music, video, Instagram, or contact card.",
  "start_url": "./",
  "scope": "./",
  "id": "/qr/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06070C",
  "theme_color": "#06070C",
  "categories": ["music", "utilities"],
  "shortcuts": [
    { "name": "Music", "short_name": "Music", "description": "Code for SoundCloud",
      "url": "./?c=music", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Video", "short_name": "Video", "description": "Code for TeknowTV",
      "url": "./?c=video", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Instagram", "short_name": "Instagram", "description": "Code for @teknowmusic",
      "url": "./?c=ig", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Contact card", "short_name": "Card", "description": "Code that saves my contact",
      "url": "./?c=card", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
